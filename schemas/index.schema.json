{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trevortomlin/homing-format/main/schemas/index.schema.json",
  "title": "homing index.json",
  "description": "Signed update index served by an HTTP source, with index.json.sig beside it.",
  "$comment": "Unknown fields are ignored everywhere. Rules JSON Schema cannot express: (id, version_code) is unique across apps; the document is at most 4 MiB.",
  "type": "object",
  "required": [
    "schema",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "generated": {
      "type": "string",
      "description": "Informational; never used for validity decisions."
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "version_code",
          "builds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "version_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "builds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "engine_hash",
                "arch",
                "url",
                "sha256",
                "size"
              ],
              "properties": {
                "engine_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Flutter engine commit the app was compiled against."
                },
                "arch": {
                  "enum": [
                    "aarch64",
                    "armv7",
                    "x86_64",
                    "riscv64"
                  ],
                  "description": "CPU architecture."
                },
                "machines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Yocto MACHINE values; empty or absent means any."
                },
                "graphics": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "drm-gles",
                      "drm-vulkan",
                      "wayland-gles",
                      "wayland-vulkan"
                    ]
                  },
                  "minItems": 1,
                  "description": "Accepted graphics backends; absent means any."
                },
                "base_image_min": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                  "description": "Minimum base image version."
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[!-\\[\\]-~]+$",
                  "description": "Relative to the index URL, or absolute http:// or https://.",
                  "anyOf": [
                    {
                      "pattern": "^[hH][tT][tT][pP][sS]?://[^/]"
                    },
                    {
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "^//"
                          },
                          {
                            "pattern": "^[^/?#]*:"
                          }
                        ]
                      }
                    }
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
