{
  "description": "homing-format test vectors. Keys are TEST ONLY. Generated by `cargo run --example gen-vectors`.",
  "device": "engine.json",
  "indexes": [
    {
      "description": "two versions; only 1.0.0 has a build for the test device",
      "expect": "PASS",
      "file": "indexes/valid.json",
      "select": [
        {
          "app": "com.example.hello",
          "expect": {
            "result": "update",
            "url": "../packages/pass-basic.homing",
            "version_code": 10000
          },
          "floor": 0,
          "installed_version_code": 0
        },
        {
          "app": "com.example.hello",
          "expect": {
            "newest_version_code": 20000,
            "result": "no_compatible_build"
          },
          "floor": 0,
          "installed_version_code": 10000
        },
        {
          "app": "com.example.hello",
          "expect": {
            "result": "up_to_date"
          },
          "floor": 0,
          "installed_version_code": 20000
        },
        {
          "app": "com.example.other",
          "expect": {
            "result": "up_to_date"
          },
          "floor": 0,
          "installed_version_code": 0
        }
      ],
      "sig": "indexes/valid.json.sig"
    },
    {
      "description": "index changed after signing",
      "expect": "E_SIG",
      "file": "indexes/sig-tampered.json",
      "select": [],
      "sig": "indexes/sig-tampered.json.sig"
    },
    {
      "description": "signed by an untrusted key",
      "expect": "E_KEY_UNKNOWN",
      "file": "indexes/key-untrusted.json",
      "select": [],
      "sig": "indexes/key-untrusted.json.sig"
    },
    {
      "description": "index signed with the manifest domain",
      "expect": "E_SIG",
      "file": "indexes/sig-wrong-domain.json",
      "select": [],
      "sig": "indexes/sig-wrong-domain.json.sig"
    },
    {
      "description": "correctly signed index with a file:// url",
      "expect": "E_SCHEMA",
      "file": "indexes/schema-file-url.json",
      "select": [],
      "sig": "indexes/schema-file-url.json.sig"
    }
  ],
  "not_covered": [
    "E_SPACE",
    "E_HEALTH",
    "E_BUSY",
    "E_PERM",
    "E_IO"
  ],
  "packages": [
    {
      "check_device": true,
      "description": "zstd package from the reference writer",
      "dev_mode": false,
      "expect": "PASS",
      "file": "packages/pass-basic.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "uncompressed tar",
      "dev_mode": false,
      "expect": "PASS",
      "file": "packages/pass-uncompressed.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "hand-built tar with old-style headers",
      "dev_mode": false,
      "expect": "PASS",
      "file": "packages/pass-hand-built.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "signed by a dev key, verified in dev mode",
      "dev_mode": true,
      "expect": "PASS",
      "file": "packages/pass-dev-key.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "dev-signed package outside dev mode",
      "dev_mode": false,
      "expect": "E_KEY_UNKNOWN",
      "file": "packages/pass-dev-key.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "version_code 10000 below floor 20000",
      "dev_mode": false,
      "expect": "E_ROLLBACK",
      "file": "packages/pass-basic.homing",
      "floor": 20000
    },
    {
      "check_device": true,
      "description": "manifest.sig before manifest.json",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-wrong-order.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "second entry is not manifest.sig",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-missing-sig.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "manifest.json larger than 1 MiB",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-oversized-manifest.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "correctly signed manifest that is not JSON",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-invalid-json.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "correctly signed manifest with schema 2",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-unknown-version.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "unknown field inside compat (fail closed)",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-unknown-compat-field.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "unknown field in manifest.sig",
      "dev_mode": false,
      "expect": "E_SCHEMA",
      "file": "packages/schema-sig-unknown-field.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "signed by a key that is not in the trust store",
      "dev_mode": false,
      "expect": "E_KEY_UNKNOWN",
      "file": "packages/key-untrusted.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "manifest changed after signing",
      "dev_mode": false,
      "expect": "E_SIG",
      "file": "packages/sig-tampered-manifest.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "manifest signed with the index domain (domain separation)",
      "dev_mode": false,
      "expect": "E_SIG",
      "file": "packages/sig-wrong-domain.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "payload file content differs from the manifest",
      "dev_mode": false,
      "expect": "E_HASH",
      "file": "packages/hash-tampered-payload.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "payload file size differs from the manifest",
      "dev_mode": false,
      "expect": "E_HASH",
      "file": "packages/hash-wrong-size.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "archive contains a file the manifest does not list",
      "dev_mode": false,
      "expect": "E_EXTRA_FILE",
      "file": "packages/extra-file-unlisted.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "a listed file is missing from the archive",
      "dev_mode": false,
      "expect": "E_EXTRA_FILE",
      "file": "packages/extra-file-missing.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "entry name escapes the package with ..",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-traversal.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "absolute entry name",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-absolute.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "symlink entry",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-symlink.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "hard link entry",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-hardlink.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "character device entry",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-device.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "the same path twice",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-duplicate.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "path outside bundle/, config/ and sbom/",
      "dev_mode": false,
      "expect": "E_PATH",
      "file": "packages/path-outside-payload.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "built for another engine commit",
      "dev_mode": false,
      "expect": "E_ENGINE",
      "file": "packages/compat-engine.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "built for x86_64",
      "dev_mode": false,
      "expect": "E_ARCH",
      "file": "packages/compat-arch.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "built for another machine",
      "dev_mode": false,
      "expect": "E_MACHINE",
      "file": "packages/compat-machine.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "needs a graphics backend the device lacks",
      "dev_mode": false,
      "expect": "E_GRAPHICS",
      "file": "packages/compat-graphics.homing",
      "floor": 0
    },
    {
      "check_device": true,
      "description": "needs a newer base image",
      "dev_mode": false,
      "expect": "E_BASE_IMAGE",
      "file": "packages/compat-base-image.homing",
      "floor": 0
    },
    {
      "check_device": false,
      "description": "compatibility is not checked without a device (host-side verify)",
      "dev_mode": false,
      "expect": "PASS",
      "file": "packages/compat-engine.homing",
      "floor": 0
    }
  ],
  "schema": 1,
  "trust_dir": "trust"
}
